// Schéma source de la base, indépendant du fournisseur (SQLite, PostgreSQL, MariaDB/MySQL).
// Ne pas modifier les fichiers prisma/<fournisseur>/schema.prisma : ils sont générés depuis ce fichier
// par « npm run db:schemas ».
//
// Conventions (schéma de départ, identique à la base historique) :
// - tables et colonnes gardent leur nom historique (snake_case) : les réponses de l'API sont inchangées ;
// - dates et heures sont des chaînes (formats « AAAA-MM-JJ » et « AAAA-MM-JJ HH:MM:SS » UTC) ;
//   /// @timestamp : horodatage par défaut à l'insertion, adapté à chaque fournisseur ;
// - booléens historiques en entiers 0/1 ;
// - aucune relation déclarée et aucune clé étrangère en base (relationMode = "prisma") : les relations
//   seront ajoutées module par module, avec un comportement à la suppression identique à l'existant.

model ActionLog {
  id          Int       @id @default(autoincrement())
  user_id     Int
  action_type String
  details     String?
  created_at  String? @default(dbgenerated("CURRENT_TIMESTAMP")) /// @timestamp

  @@map("action_logs")
}

model AffectationAssignment {
  id          Int       @id @default(autoincrement())
  project_id  Int
  stage_key   String
  resource_id Int
  created_at  String? @default(dbgenerated("CURRENT_TIMESTAMP")) /// @timestamp

  @@unique([project_id, stage_key, resource_id])

  @@map("affectation_assignments")
}

model AffectationHistory {
  id         Int       @id @default(autoincrement())
  project_id Int
  samu_name  String?
  user_id    Int?
  user_name  String?
  action     String
  details    String?
  created_at String? @default(dbgenerated("CURRENT_TIMESTAMP")) /// @timestamp

  @@index([project_id, id], map: "idx_aff_hist_project")

  @@map("affectation_history")
}

model AffectationProject {
