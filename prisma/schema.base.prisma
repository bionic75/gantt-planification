}

/// Planning des astreintes HO (heures ouvrées) : une ligne par expert inscrit sur une demi-journée (AM / PM) d'un jour ouvré
model AstreinteHoSlot {
  id          Int       @id @default(autoincrement())
  date        String
  period      String
  resource_id Int
  created_by  Int?
  created_at  String? @default(dbgenerated("CURRENT_TIMESTAMP")) /// @timestamp

  @@unique([date, period, resource_id])
  @@index([date], map: "idx_astreinte_ho_slots_date")
  @@map("astreinte_ho_slots")
}

/// Historique des modifications du planning HO (ajout / retrait d'un expert sur une demi-journée)
model AstreinteHoLog {
  id            Int       @id @default(autoincrement())
  slot_date     String
  period        String
  resource_id   Int
  resource_name String?
  action        String
  week_start    String
  user_id       Int?
  user_name     String?
  created_at    String? @default(dbgenerated("CURRENT_TIMESTAMP")) /// @timestamp

  @@index([week_start], map: "idx_astreinte_ho_log_week")
  @@map("astreinte_ho_log")
}

/// Rétroplanning automatisé des ateliers métier d'un SAMU (une ligne par SAMU) : paramètres et dates réellement planifiées
model AtelierRetroplanning {
  id                   Int       @id @default(autoincrement())
  samu_name            String    @unique
  project_id           Int?
  zone                 String
  mep_date             String
  nb_ateliers          Int
  visite_date          String?
  delai_visite_atelier Int       @default(14)
  delai_mep            Int       @default(28)
  /// JSON : jalons et contenus choisis pour chaque atelier, dates réellement planifiées
  lignes               String?
  created_by           Int?
  created_by_name      String?
  last_sent_at         String?
  created_at           String? @default(dbgenerated("CURRENT_TIMESTAMP")) /// @timestamp
  updated_at           String? @default(dbgenerated("CURRENT_TIMESTAMP")) /// @timestamp

  @@map("atelier_retroplannings")
}

