  value        String
  notification String?   @default("0")
  created_at   String? @default(dbgenerated("CURRENT_TIMESTAMP")) /// @timestamp

  @@unique([resource_id, date_key, type])

  @@map("schedule_data")
}

/// Sessions HTTP (express-session) : données de session en JSON, expiration « AAAA-MM-JJ HH:MM:SS » UTC
model Session {
  sid        String @id
  user_id    Int?
  data       String
  expires_at String

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("settings")
}

model SystemConfig {
  id         Int       @id @default(autoincrement())
  version    String
  updated_at String? @default(dbgenerated("CURRENT_TIMESTAMP")) /// @timestamp

  @@map("system_config")
}

model User {
  id                   Int       @id @default(autoincrement())
  username             String    @unique
  password             String
  nom                  String
  prenom               String
  email                String
  telephone            String?
  is_admin             Int?      @default(0)
  is_expert            Int?      @default(0)
  is_user              Int?      @default(0)
  resource_id          Int?
  actif                Int?      @default(1)
  created_at           String? @default(dbgenerated("CURRENT_TIMESTAMP")) /// @timestamp
  totp_secret          String?
  default_tab          String?   @default("planning")
  profile_photo        String?
  trigramme            String?
  has_reporting_access Int?      @default(0)
  amoa_ced             Int?      @default(0)
  is_rh                Int?      @default(0)
  /// 1 : mot de passe donné par un administrateur, à remplacer à la prochaine connexion
  must_change_password Int       @default(0)

  @@map("users")
}
