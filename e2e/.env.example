# Configuration des tests de bout en bout (Playwright BDD).
# Copier ce fichier en .env et l'adapter. Ne jamais versionner .env : il contient les mots de passe.

# ---------------------------------------------------------------------------------------------------------------
# Application testée
# ---------------------------------------------------------------------------------------------------------------

# URL de l'application, sans / final (locale par défaut)
E2E_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------------------------------------------
# Comptes de test (un par profil)
# ---------------------------------------------------------------------------------------------------------------

E2E_EXPERT_LOGIN=planifexpert.testsansurgences
E2E_EXPERT_PASSWORD=

E2E_UTILISATEUR_LOGIN=planifutilisateur.testsansurgences
E2E_UTILISATEUR_PASSWORD=

E2E_RH_LOGIN=planifrh.testsansurgences
E2E_RH_PASSWORD=

E2E_ADMINISTRATEUR_LOGIN=planifadministrateur.testsansurgences
E2E_ADMINISTRATEUR_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------
# Boîte e-mail partagée qui reçoit les codes de double authentification (OTP)
# ---------------------------------------------------------------------------------------------------------------

# imap (boîte réelle) | mailpit (serveur SMTP de test local, API HTTP)
E2E_MAIL_PROVIDER=imap

# IMAP
E2E_IMAP_HOST=
E2E_IMAP_PORT=993
E2E_IMAP_SECURE=true
E2E_IMAP_USER=
E2E_IMAP_PASSWORD=
E2E_IMAP_MAILBOX=INBOX

# Mailpit (si E2E_MAIL_PROVIDER=mailpit)
E2E_MAILPIT_URL=http://localhost:8025

# Adresse de la boîte partagée (destinataire des codes, contacts RH des CRA de test)
E2E_SHARED_MAILBOX=
# Objet des e-mails de code (extrait suffisant)
E2E_OTP_SUBJECT=Code de vérification
# Délai maximal d'attente d'un code (secondes)
E2E_OTP_TIMEOUT=90

# Secrets TOTP des comptes (facultatif : scénario « MFA par application TOTP »)
E2E_ADMINISTRATEUR_TOTP_SECRET=
E2E_EXPERT_TOTP_SECRET=
E2E_UTILISATEUR_TOTP_SECRET=

# ---------------------------------------------------------------------------------------------------------------
# Comportement de la campagne
# ---------------------------------------------------------------------------------------------------------------

# Réutiliser les sessions déjà ouvertes (.auth/) tant qu'elles sont valides : évite un code OTP par lancement
E2E_REUSE_AUTH=true
# Durée maximale de réutilisation d'une session enregistrée (heures)
E2E_AUTH_MAX_AGE_HOURS=8

# Scénarios exclus par défaut (expression de tags Cucumber). Exemple pour tout lancer : E2E_TAGS=not @manuel
E2E_TAGS=not @manuel and not @destructif and not @exploitation and not @asana and not @lent

# Workers Playwright pour les scénarios métier (les connexions restent séquentielles quoi qu'il arrive)
E2E_WORKERS=2

# Jeu de données Asana de test disponible (scénarios @asana)
E2E_ASANA_ENABLED=false
# Une session sur un SMTP de test est configurée dans l'application (diffusion des CRA, envoi de test)
E2E_SMTP_TEST=true
# Parité des routes (@exploitation) : entrée du serveur de l'ancienne version, ex. server.legacy.js
E2E_PARITY_REFERENCE=
# Autoriser la réinitialisation des validations MFA des comptes de test (réinitialise aussi leur TOTP)
E2E_ALLOW_MFA_RESET=false
