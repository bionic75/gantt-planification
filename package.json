{
  "name": "gantt-planification",
  "version": "3.1.0",
  "description": "Gestionnaire de ressources et planification GANTT",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/scripts/db-migrate.mjs && node backend/server.js",
    "dev": "node backend/scripts/db-migrate.mjs && node --watch backend/server.js",
    "postinstall": "prisma generate --config backend/prisma.config.js",
    "db:generate": "prisma generate --config backend/prisma.config.js",
    "db:migrate": "node backend/scripts/db-migrate.mjs",
    "db:adopt": "node backend/scripts/db-adopt.mjs",
    "db:migration": "node backend/scripts/create-migration.mjs",
    "db:transfer": "node backend/scripts/db-transfer.mjs",
    "db:schemas": "node backend/scripts/build-prisma-schemas.mjs && prisma format --schema backend/prisma/sqlite/schema.prisma && prisma format --schema backend/prisma/postgresql/schema.prisma && prisma format --schema backend/prisma/mysql/schema.prisma",
    "test": "vitest run --config backend/vitest.config.js",
    "test:watch": "vitest --config backend/vitest.config.js",
    "build:front": "vite build --config frontend/vite.config.ts",
    "test:front": "vitest run --config frontend/vite.config.ts",
    "typecheck:front": "vue-tsc --noEmit -p frontend/tsconfig.json",
    "test:parity": "node backend/tests/parity/route-parity.mjs",
    "routes": "node backend/scripts/routes.mjs",
    "app:version": "node backend/scripts/set-version.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "gantt",
    "planification",
    "ressources"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.17.3",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "pptxgenjs": "^4.0.1",
    "prisma": "^7.10.1",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "overrides": {
    "image-size": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "1.9.22",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "body-parser": "^1.20.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "leaflet": "1.9.4",
    "mariadb": "^3.5.4",
    "pg": "^8.23.1",
    "pinia": "4.0.3",
    "prettier": "^3.9.10",
    "sqlite3": "^6.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "vue-tsc": "3.3.13",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
