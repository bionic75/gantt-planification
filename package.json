{
  "name": "gantt-planification",
  "version": "3.6.1",
  "description": "Gestionnaire de ressources et planification GANTT",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node backend/scripts/db-migrate.ts && node backend/server.ts",
    "dev": "node backend/scripts/db-migrate.ts && node --watch backend/server.ts",
    "db:generate": "npm run db:generate -w backend --",
    "db:migrate": "node backend/scripts/db-migrate.ts",
    "db:adopt": "node backend/scripts/db-adopt.ts",
    "db:migration": "node backend/scripts/create-migration.ts",
    "db:transfer": "node backend/scripts/db-transfer.ts",
    "db:schemas": "npm run db:schemas -w backend --",
    "test": "npm run test -w backend --",
    "test:watch": "npm run test:watch -w backend --",
    "build:front": "npm run build -w frontend --",
    "test:front": "npm run test -w frontend --",
    "typecheck:front": "npm run typecheck -w frontend --",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "typecheck:back": "npm run typecheck -w backend --",
    "test:parity": "node backend/tests/parity/route-parity.ts",
    "routes": "node backend/scripts/routes.ts",
    "app:version": "node backend/scripts/set-version.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "gantt",
    "planification",
    "ressources"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=26.13.1"
  },
  "overrides": {
    "image-size": "^2.0.4",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "bcrypt": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "puppeteer@25.16.0": true
  }
}
