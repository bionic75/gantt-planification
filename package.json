{
  "name": "gantt-planification",
  "version": "2.0.1",
  "description": "Gestionnaire de ressources et planification GANTT",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node scripts/db-migrate.mjs && node server.js",
    "dev": "node scripts/db-migrate.mjs && node --watch server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:adopt": "node scripts/db-adopt.mjs",
    "db:migration": "node scripts/create-migration.mjs",
    "db:transfer": "node scripts/db-transfer.mjs",
    "db:schemas": "node scripts/build-prisma-schemas.mjs && prisma format --schema prisma/sqlite/schema.prisma && prisma format --schema prisma/postgresql/schema.prisma && prisma format --schema prisma/mysql/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "node tests/parity/route-parity.mjs",
    "routes": "node scripts/routes.mjs",
    "app:version": "node scripts/set-version.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "gantt",
    "planification",
    "ressources"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.17.3",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "pptxgenjs": "^4.0.1",
    "prisma": "^7.10.1",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "image-size": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "body-parser": "^1.20.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "mariadb": "^3.5.4",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "sqlite3": "^6.0.1",
    "vitest": "^5.0.5"
  }
}
