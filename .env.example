# Copier ce fichier en .env et l'adapter. Les variables d'environnement du système sont prioritaires.
# La configuration est validée au démarrage (src/config/env.js) : le serveur refuse de démarrer si elle est invalide.
# Ne jamais versionner le fichier .env : il contient les secrets (.gitignore).
# En production, le .env du serveur est réécrit à chaque déploiement (workflows deploy-*.yml) depuis les secrets
# GitHub PROD_SESSION_SECRET, PROD_APP_URL, PROD_APP_DATA_PATH et PROD_DB_HOST / _PORT / _NAME / _USER / _PASSWORD.
# APP_DATA_PATH (répertoire des données sur le serveur) est lu par docker-compose.yml, pas par l'application.

# development | test | production
NODE_ENV=development

# Port d'écoute HTTP
PORT=3000

# URL publique de l'application (liens dans les emails), sans / final.
# OBLIGATOIRE en production. Hors production, déduite de la requête HTTP si absente.
APP_URL=

# ---------------------------------------------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------------------------------------------

# Secret de signature des cookies de session.
# OBLIGATOIRE en production (32 caractères minimum). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Hors production, un secret aléatoire est généré à chaque démarrage s'il est absent.
SESSION_SECRET=

# Identifiants de la base de données (PostgreSQL / MariaDB, voir ci-dessous)
DB_USER=
DB_PASSWORD=

# Les autres identifiants ne sont pas dans l'environnement :
# - serveur SMTP : saisi dans l'administration de l'application (enregistré en base) ;
# - jeton Asana : saisi dans l'administration, chiffré en base avec une clé propre au serveur (DB_PATH/.asana_key).

# ---------------------------------------------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------------------------------------------

# Fournisseur : sqlite (défaut) | postgresql | mysql (MariaDB / MySQL).
# Changer de fournisseur demande de régénérer le client : npm run db:generate
DB_PROVIDER=sqlite

# PostgreSQL / MariaDB : soit les éléments de connexion (identifiants ci-dessus, encodés automatiquement)…
DB_HOST=
# Défaut : 5432 (PostgreSQL), 3306 (MariaDB)
DB_PORT=
DB_NAME=
# … soit l'URL complète, prioritaire si renseignée (caractères spéciaux du mot de passe à encoder) :
#   postgresql://utilisateur:motdepasse@hote:5432/planning
#   mysql://utilisateur:motdepasse@hote:3306/planning
DATABASE_URL=

# Répertoire de la base SQLite (fichier data.db) et des fichiers de l'application (PDF des CRA, sauvegardes).
# Défaut : valeur de config/config.json, sinon ./data
DB_PATH=./data

# ---------------------------------------------------------------------------------------------------------------
# Divers
# ---------------------------------------------------------------------------------------------------------------

# Expéditeur des notifications Teams (sinon noreply@esante.gouv.fr)
SMTP_USER=

# API Asana (à modifier uniquement pour les tests)
# ASANA_API_BASE=https://app.asana.com/api/1.0

# Chemin vers LibreOffice (conversion PPTX → PDF) et Chromium (génération PDF)
SOFFICE_PATH=
PUPPETEER_EXECUTABLE_PATH=
