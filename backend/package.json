{
  "name": "@gantt-planification/backend",
  "private": true,
  "description": "Serveur : API Express, base de données Prisma, tâches planifiées",
  "type": "module",
  "scripts": {
    "postinstall": "cd .. && prisma generate --config backend/prisma.config.ts",
    "db:generate": "cd .. && prisma generate --config backend/prisma.config.ts",
    "db:schemas": "node scripts/build-prisma-schemas.ts && prisma format --schema prisma/sqlite/schema.prisma && prisma format --schema prisma/postgresql/schema.prisma && prisma format --schema prisma/mysql/schema.prisma",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.17.3",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "pptxgenjs": "^4.0.1",
    "prisma": "^7.10.1",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/express-session": "1.19.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "mariadb": "^3.5.4",
    "pg": "^8.23.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
